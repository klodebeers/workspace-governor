#!/bin/sh
# Authoritative content gates. See .claude/hooks/README.md.
#
# A shell shim rather than a python shebang: the operator's machine is Windows,
# where Git runs hooks under its bundled sh and the interpreter may be `python`
# or the `py` launcher rather than `python3`. A hook that cannot find an
# interpreter must fail the commit, never pass it -- LEARNINGS.md L-026.
ROOT=$(git rev-parse --show-toplevel) || exit 1
SCRIPT="$ROOT/.claude/hooks/git_pre_commit.py"
if command -v python3 >/dev/null 2>&1; then exec python3 "$SCRIPT" "$@"; fi
if command -v python  >/dev/null 2>&1; then exec python  "$SCRIPT" "$@"; fi
if command -v py      >/dev/null 2>&1; then exec py -3   "$SCRIPT" "$@"; fi
echo "pre-commit gate: no Python interpreter found (tried python3, python, py)." >&2
echo "The content gates could not run, so this commit is refused rather than" >&2
echo "allowed unchecked. Install Python or put it on PATH." >&2
exit 1
